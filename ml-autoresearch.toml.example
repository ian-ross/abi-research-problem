[runtime_images]
# Absolute path to an editable Harness checkout; omit when using an installed package.
dev_source_path = "/path/to/ml-autoresearch"
runner_requirements = [
  "zarr>=3.2.1,<4",
  "pandas>=3,<4",
  "pyarrow>=25,<26",
  "scipy>=1.18,<2",
]

[candidate_execution]
backend = "docker"
# Generated by: uv run ml-autoresearch build-runtime-images --workspace-root . --update-config
docker_image = "ml-autoresearch-runner:generated-by-build-runtime-images"
docker_enable_gpu = true
# Harness-owned single-device pin used when run-candidate omits --docker-gpu-device.
docker_gpu_device = "0"
docker_rootless_container_root = true
runs_root = "/path/to/abi-ml-autoresearch/runs"
ledger_path = "research-ledger.jsonl"
max_prediction_samples = 2
prediction_sample_policy = "first_n"

[research_problem]
id = "goes_abi_contrail_segmentation"
package_root = "."
provider_target = "abi_contrail.research_problem:build_spec"
expected_contract_version = "v0"

[research_problem.data_roots]
training = "/path/to/contrail-detection"
ancillary = "/path/to/abi-ml-autoresearch/ancillary"
baselines = "/path/to/abi-ml-autoresearch/baselines"

[research_problem.data_config]
# Generated and verified with abi-baseline-targets. The relative path remains
# valid when the Harness maps the trusted root to /data/baselines in Docker.
canonical_baseline_targets = "canonical/mcast-working-validation-v1.json"
mcast_detection_1_1_path = "canonical/model-assets/detection-1.1.pt"
mcast_detection_2_1_path = "canonical/model-assets/detection-2.1"
# Provision with abi-provision-natural-earth before setup/evaluation. These
# paths remain valid when the Harness maps the roots to /data/training and
# /data/ancillary in Docker.
geographic_filter_required = true
geographic_ancillary_manifest = "natural-earth/manifest.json"
coastline_geojson = "natural-earth/natural_earth_10m_coastline.geojson"
rivers_geojson = "natural-earth/natural_earth_10m_rivers_north_america.geojson"
# Bounds CUDA/CPU postprocessing memory independently of validation size.
postprocessing_batch_size = 8

[[research_problem.data_config.sources]]
layout = "mit"
inputs_zarr = "mit/inputs.zarr"
labels_zarr = "mit/labels.zarr"
metadata_parquet = "mit/metadata.parquet"
val_fraction = 0.2
split_seed = 20260712
patch_size = 256
stride = 256

[[research_problem.data_config.sources]]
layout = "google"
inputs_zarr = "google/inputs.zarr"
labels_zarr = "google/labels.zarr"
metadata_parquet = "google/metadata.parquet"

[agent_control_boundary]
distro = "debian"
# Replaced by build-runtime-images --update-config.
image = "/path/to/abi-research-problem/.ml-autoresearch/images/agent"
allow_egress = true

# Optional local-only notification credentials:
# [mailjet]
# api_key = "..."
# api_secret = "..."
# from_email = "verified-sender@example.com"
# from_name = "ABI ML Autoresearch"
